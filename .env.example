# Copy to .env and fill in local credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: microphone name or PyAudio device index; defaults to Windows input,
# or auto-selects the device named Microphone when Windows has no default input.
FRIDAY_MIC_DEVICE=
# Optional IANA time zone for calendar events; defaults to Asia/Kolkata.
FRIDAY_TIMEZONE=Asia/Kolkata
# Home city used when a weather request does not name a city.
FRIDAY_WEATHER_LOCATION=Bhubaneswar
